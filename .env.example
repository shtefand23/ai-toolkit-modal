# Modal UI server port
AI_TOOLKIT_UI_PORT=8675

# Modal GPU type, e.g. L4 / A10 / L40S / A100
AI_TOOLKIT_GPU=L4

# Modal function timeout (seconds)
AI_TOOLKIT_TIMEOUT=86400

# UI persistent data volume name
AI_TOOLKIT_UI_VOLUME=ai-toolkit-ui-data

# Dataset volume name
AI_TOOLKIT_DATA_VOLUME=ai-toolkit-datasets

# Volume auto-commit interval (seconds)
AI_TOOLKIT_VOLUME_COMMIT_INTERVAL=30

# Optional: UI login password; leave empty to disable
AI_TOOLKIT_AUTH=

# Optional: local directory to auto-sync to Modal dataset volume on startup
AI_TOOLKIT_LOCAL_DATA_FOLDER=./datasets

# Optional: extra data directory for first-time import only; won't overwrite existing datasets
AI_TOOLKIT_LOCAL_DATASET_SOURCE=

# Optional: local training config directory, mounted to /root/local_configs in the container
AI_TOOLKIT_LOCAL_CONFIG_DIR=./config

# Default training config file
# If a relative path, it's resolved relative to AI_TOOLKIT_LOCAL_CONFIG_DIR
# Multiple configs can be comma-separated
AI_TOOLKIT_TRAIN_CONFIG=train_lora_flux_dev_modal_minimal.yaml

# Extra training arguments, e.g. --sample_every_n_steps 100
AI_TOOLKIT_TRAIN_EXTRA_ARGS=

# Training function timeout (seconds)
AI_TOOLKIT_TRAIN_TIMEOUT=7200

# Training output volume name
AI_TOOLKIT_MODEL_VOLUME=ai-toolkit-models

# Training output directory inside the container; UI maps it to /root/ai-toolkit/output
AI_TOOLKIT_TRAIN_OUTPUT_DIR=/root/ai-toolkit/modal_output
